{
    "name": "erikwestlund/phplyr",
    "description": "A dplyr-style grammar of data manipulation for PHP 8.5 pipes",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "erikwestlund/phibble": "@dev"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "ext-php_stats": "Native descriptives and model fitting (stats_*), needed for lm() and glm()"
    },
    "autoload": {
        "psr-4": {
            "Phplyr\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phplyr\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [{
        "name": "phibble",
        "type": "path",
        "url": "/Users/erik/.polyscope/clones/4fdf7c2b/topaz-duck",
        "options": {
            "symlink": true
        }
    }]
}
